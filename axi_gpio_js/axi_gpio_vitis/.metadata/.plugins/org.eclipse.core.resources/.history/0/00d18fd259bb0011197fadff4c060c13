/*
 * helloworld.c: simple test application
 *
 * This application configures UART 16550 to baud rate 9600.
 * PS7 UART (Zynq) is not initialized by this application, since
 * bootrom/bsp configures it to baud rate 115200
 *
 * ------------------------------------------------
 * | UART TYPE   BAUD RATE                        |
 * ------------------------------------------------
 *   uartns550   9600
 *   uartlite    Configurable only in HW design
 *   ps7_uart    115200 (configured by bootrom/bsp)
 */

#include <stdio.h>
#include "platform.h"
#include "xil_printf.h"
#include "xgpio.h"
#include "xparameters.h"
#include "xstatus.h"


#define GPIO_CHANNEL          1

// (SW0 to SW3)
#define SW_0                  0x01 /* Red */
#define SW_1                  0x02 /* Green */
#define SW_2                  0x04 /* Blue */
#define SW_3                  0x08 /* White */
#define BINARY_COUNTER_MASK   0x03 /* SW0 and SW1 active */
#define RING_COUNTER_MASK     0x0C /* SW2 and SW3 active */

// Color definition masks
#define LED_OFF               0x00
#define LED_RED               0x04
#define LED_GREEN             0x02
#define LED_BLUE              0x01
#define LED_WHITE             0x07

#define LED_DELAY             (10000000)

static void software_delay(void) {
    volatile unsigned int delay;
    for (delay = 0; delay < LED_DELAY; delay++) {
        /* do nothing */
    }
}

int main(void) {
    XGpio Gpio_led;
    XGpio Gpio_rgb;
    XGpio Gpio_sw;
    int status;

    /* Local tracking state variables */
    u32 current_sw_state = 0x00;
    u32 binary_counter = 0x00;
    u32 ring_counter = 0x01;

    init_platform();

    /* Initialize each AXI GPIO using correct upper-case Xilinx parameters */
    status = XGpio_Initialize(&Gpio_led, XPAR_AXI_GPIO_0_DEVICE_ID);
    if (status != XST_SUCCESS) {
        xil_printf("Initialization of LED fail.\r\n");
        return XST_FAILURE;
    }
    xil_printf("Initialization of LED pass.\r\n");

    status = XGpio_Initialize(&Gpio_rgb, XPAR_AXI_GPIO_1_DEVICE_ID);
    if (status != XST_SUCCESS) {
        xil_printf("Initialization of RGB fail.\r\n");
        return XST_FAILURE;
    }
    xil_printf("Initialization of RGB pass.\r\n");

    status = XGpio_Initialize(&Gpio_sw, XPAR_AXI_GPIO_2_DEVICE_ID);
    if (status != XST_SUCCESS) {
        xil_printf("Initialization of SW fail.\r\n");
        return XST_FAILURE;
    }
    xil_printf("Initialization of SW pass.\r\n");

    /* Set data directions (0 = output, 1 = input) */
    XGpio_SetDataDirection(&Gpio_led, GPIO_CHANNEL, 0x00);
    XGpio_SetDataDirection(&Gpio_rgb, GPIO_CHANNEL, 0x00);
    XGpio_SetDataDirection(&Gpio_sw,  GPIO_CHANNEL, 0x0F);

    /* Establish safe default startup values */
    XGpio_DiscreteWrite(&Gpio_led, GPIO_CHANNEL, LED_OFF);
    XGpio_DiscreteWrite(&Gpio_rgb, GPIO_CHANNEL, LED_OFF);

    /* Polling loop */
    while(1) {
        // Read current state and mask out bits outside SW0-SW3
        current_sw_state = XGpio_DiscreteRead(&Gpio_sw, GPIO_CHANNEL) & 0x0F;

        /* SW_0 only */
        if (current_sw_state == SW_0) {
            XGpio_DiscreteWrite(&Gpio_led, GPIO_CHANNEL, LED_RED);
            XGpio_DiscreteWrite(&Gpio_rgb, GPIO_CHANNEL, LED_RED);
        }
        /* SW_1 only */
        else if (current_sw_state == SW_1) {
            XGpio_DiscreteWrite(&Gpio_led, GPIO_CHANNEL, LED_GREEN);
            XGpio_DiscreteWrite(&Gpio_rgb, GPIO_CHANNEL, LED_GREEN);
        }
        /* SW_2 only */
        else if (current_sw_state == SW_2) {
            XGpio_DiscreteWrite(&Gpio_led, GPIO_CHANNEL, LED_BLUE);
            XGpio_DiscreteWrite(&Gpio_rgb, GPIO_CHANNEL, LED_BLUE);
        }
        /* SW_3 only */
        else if (current_sw_state == SW_3) {
            XGpio_DiscreteWrite(&Gpio_led, GPIO_CHANNEL, LED_WHITE);
            XGpio_DiscreteWrite(&Gpio_rgb, GPIO_CHANNEL, LED_WHITE);
        }
        /* SW_0 and SW_1 both active */
        else if (current_sw_state == BINARY_COUNTER_MASK) {
            XGpio_DiscreteWrite(&Gpio_rgb, GPIO_CHANNEL, LED_OFF);
            XGpio_DiscreteWrite(&Gpio_led, GPIO_CHANNEL, binary_counter);
            software_delay();
            binary_counter++;
        }
        /* SW2 and SW3 both active */
        else if (current_sw_state == RING_COUNTER_MASK) {
            XGpio_DiscreteWrite(&Gpio_rgb, GPIO_CHANNEL, LED_OFF);
            XGpio_DiscreteWrite(&Gpio_led, GPIO_CHANNEL, ring_counter);
            software_delay();

            /* Shift 1 bit to the left */
            ring_counter = ring_counter << 1;
            if (ring_counter >= 0x10) { // Reset once it shifts past the 4 basic LEDs
                ring_counter = 0x01;
            }
        }
        /* No switches or invalid combination */
        else {
            XGpio_DiscreteWrite(&Gpio_rgb, GPIO_CHANNEL, LED_OFF);
            XGpio_DiscreteWrite(&Gpio_led, GPIO_CHANNEL, LED_OFF);
            binary_counter = 0x00; // Reset counters when not in use
            ring_counter = 0x01;
        }
    }

    cleanup_platform();
    return 0;
}

