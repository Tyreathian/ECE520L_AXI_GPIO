/*
 * helloworld.c: simple test application
 *
 * This application configures UART 16550 to baud rate 9600.
 * PS7 UART (Zynq) is not initialized by this application, since
 * bootrom/bsp configures it to baud rate 115200
 *
 * ------------------------------------------------
 * | UART TYPE   BAUD RATE                        |
 * ------------------------------------------------
 *   uartns550   9600
 *   uartlite    Configurable only in HW design
 *   ps7_uart    115200 (configured by bootrom/bsp)
 */

#include <stdio.h>
#include "platform.h"
#include "xil_printf.h"
#include "xgpio.h"
#include "xparameters.h"

#define gpio_channel

#define sw_val 0x0F
#define SW_0 0x01 /* Red */
#define SW_1 0x02 /* Green */
#define SW_2 0x04 /* Blue */
#define SW_3 0x08 /* White */
#define Binary_Counter 0x03 /* RGB LED OFF */
#define Ring_Counter 0xC /* RGB LED OFF */
#define binary_counter_value 0x00
#define ring_counter_value 0x00

#define led_off 0x00
#define led_red 0x01
#define led_green 0x02
#define led_blue 0x04
#define led_white 0x07

#define led_delay (10000000)

static void software_delay(void)
{
	volatile unsigned int delay;
	for (delay = 0; delay < led_delay; delay++)
	{
		/* do nothing */
	}
}

int main(void)
{
	XGpio gpio_led;
	XGpio gpio_rgb;
	XGpio gpio_sw;

	int status;
	/* initial values and states */
	u4 sw;
	u4 binary_counter;
	u4 ring_counter;

	sw = 0x00;
	binary_counter = 0x00;
	ring_counter = 0x01;

	/* initialize each axi gpio 0-2 */
	status = XGpio_Initialize(&Gpio_rgb, xpar_XGpio_0_Baseaddr);
	if (status != xst_success)
	{
		xil_printf("Initialization of LED fail.\r\n");
	}
	xil_printf("Initialization of LED pass.\r\n");

	status = XGpio_Initialize(&Gpio_rgb, xpar_XGpio_0_Baseaddr);
		if (status != xst_success)
		{
			xil_printf("Initialization of RGB fail.\r\n");
		}
		xil_printf("Initialization of RGB pass.\r\n");

	status = XGpio_Initialize(&Gpio_rgb, xpar_XGpio_2_Baseaddr);
			if (status != xst_success)
			{
				xil_printf("Initialization of SW fail.\r\n");
			}
			xil_printf("Initialization of SW pass.\r\n");

	XGpio_SetDataDirection(&Gpio_led, Gpio_channel, 0x00); /* Regular LED are outputs */

	XGpio_SetDataDirection(&Gpio_rgb, Gpio_channel, 0x00); /* RGB led output */

	XGpio_SetDataDirection(&Gpio_sw, Gpio_channel, 0x0F); /* SW0-3 are input */

	XGpio_DiscreteWrite(&Gpio_led, Gpio_channel, led_off); /* default sw to 0 */

	XGpio_DiscreteWrite(&Gpio_rgb, Gpio_channel, rgb_off); /* default sw to 0 */

	/* Polling logic for the switch cases */

	while(1)
	{
		sw_val &= 0x0F;
		sw_val = XGpio_DiscreteRead(&Gpio_sw, Gpio_channel);
		/* SW_0 only */
		if (sw_val == SW_0)
		{
			XGpio_DiscreteWrite(&Gpio_led, Gpio_channel, led_red);
			XGpio_DiscreteWrite(&Gpio_rgb, Gpio_channel, led_red);
		}
		/* SW_1 only */
		else if (sw_val == SW_1)
		{
			XGpio_DiscreteWrite(&Gpio_led, Gpio_channel, led_green);
			XGpio_DiscreteWrite(&Gpio_rgb, Gpio_channel, led_green);
		}
		/* SW_2 only */
		else if (sw_val == SW_2)
				{
					XGpio_DiscreteWrite(&Gpio_led, Gpio_channel, led_blue);
					XGpio_DiscreteWrite(&Gpio_rgb, Gpio_channel, led_blue);
				}
		/* SW_3 only */
		else if (sw_val == SW_3)
				{
					XGpio_DiscreteWrite(&Gpio_led, Gpio_channel, led_white);
					XGpio_DiscreteWrite(&Gpio_rgb, Gpio_channel, led_white);
				}
		/* SW_0 and SW_1 */
		else if (sw_val == binary_counter)
		{
			binary_counter_value = 0x00;

			XGpio_DiscreteWrite(&Gpio_rgb, Gpio_channel, led_off);
			XGpio_DiscreteWrite(&Gpio_led, Gpio_channel, Binary_counter);

			Software_Delay();
			binary_counter_value++;
		}
		/* SW3 and SW4 */
		else if (sw_val == Ring_Counter)
		{
			ring_counter_value = 0x01;

			XGpio_DiscreteWrite(&Gpio_rgb, Gpio_channel, led_off);
			XGpio_DiscreteWrite(&Gpio_led, Gpio_channel, Ring_Counter);
			Software_Delay();
			/* Shift 1 bit to the left */
			ring_counter_value = ring_counter_value << 1;
			if (ring_counter_value == 0x08)
			{
				ring_counter_value = 0x01;
			}
		}
		/* Invalid cases */
		else
		{
			XGpio_DiscreteWrite(&Gpio_rgb, Gpio_channel, led_off);
			XGpio_DiscreteWrite(&Gpio_led, Gpio_channel, led_off);
		}
	}
	return 0;
}
